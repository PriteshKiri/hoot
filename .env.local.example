# Supabase credentials
# For local development, run `npx supabase start` and use the values it prints.
# The defaults below match the Supabase CLI's well-known local development keys
# (safe to commit; they only work against a local Supabase instance).
#
# For a hosted or self-hosted Supabase instance, replace these with the values
# from your project's API settings (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Public base URL of your deployment. Used to build participant join URLs and
# QR codes in server-rendered views. Set this to the URL your participants
# reach (e.g. https://hoot.example.com). Defaults to http://localhost:3000
# in local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
